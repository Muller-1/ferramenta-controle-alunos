<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN" "http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<Menu>
  <Name>Applications</Name>
  <Menu>
    <Name>Personalizado</Name>
    <Directory>personalizado.directory</Directory>
    <Include><Category>X-Personalizado</Category></Include>
    <!-- Pasta do laboratório, dentro de Personalizado. Os itens dela têm Categories=X-Laboratorio. -->
    <Menu>
      <Name>Laboratorio</Name>
      <Directory>laboratorio.directory</Directory>
      <Include><Category>X-Laboratorio</Category></Include>
      <!-- Ordem: o painel fixado no topo, uma linha, e o resto em ordem alfabética -->
      <Layout>
        <Filename>lab-painel.desktop</Filename>
        <Separator/>
        <Merge type="all"/>
      </Layout>
    </Menu>
  </Menu>
</Menu>
