#!/usr/bin/env bash
# lab — comandos do professor para os PCs do laboratório, pelo SSH.
#   lab <ação> [todos | a1 b2 c3 ...]
# Ações: fechar-roblox | tirar-conta-roblox | fechar-apps | bloquear-input | liberar-input | travar-tela | liberar-tela | reiniciar | desligar | sair | entrar | estado | reiniciar-veyon
#        status        mostra quais PCs estão no ar e quem está logado
# Sem PCs informados = todos. Lista de PCs: ~/.ssh/ips-lab-testados.txt
LISTA="$HOME/.ssh/ips-lab-testados.txt"
CHAVE="$HOME/.ssh/lab_nopass_ed25519"
LIB="/usr/local/lib/lab"
ACAO="${1:-}"; shift || true
case "$ACAO" in
  fechar-roblox|tirar-conta-roblox|fechar-apps|bloquear-input|liberar-input|travar-tela|liberar-tela|reiniciar|desligar|sair|entrar|estado|reiniciar-veyon|status) ;;
  *) sed -n '2,7p' "$0"; exit 1 ;;
esac
# nome: ip
mapfile -t TODOS < <(grep -E '^[a-f][0-9]+: +[0-9.]+' "$LISTA" | sed -E 's/^([a-f][0-9]+): +([0-9.]+).*/\1 \2/')
ALVOS=()
if [[ $# -eq 0 || "${1:-}" == "todos" ]]; then ALVOS=("${TODOS[@]}")
else for n in "$@"; do for l in "${TODOS[@]}"; do [[ "${l%% *}" == "$n" ]] && ALVOS+=("$l"); done; done; fi
[[ ${#ALVOS[@]} -gt 0 ]] || { echo "nenhum PC encontrado em $LISTA"; exit 1; }
SSH=(ssh -F /dev/null -i "$CHAVE" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new)
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
for l in "${ALVOS[@]}"; do
  n="${l%% *}"; ip="${l##* }"
  (
    if [[ "$ACAO" == "status" ]]; then
      r="$("${SSH[@]}" "$n@$ip" 'echo "$(hostname) | $(loginctl list-sessions --no-legend | awk "\$4==\"seat0\"{printf \"%s(%s) \", \$3, \$6}")"' 2>&1 | tail -1)"
    else
      r="$("${SSH[@]}" "$n@$ip" "sudo -n $LIB/$ACAO" 2>&1 | tail -1)"
    fi
    [[ -n "$r" ]] || r="(sem resposta)"
    echo "$n: $r" > "$TMP/$n"
  ) &
done
wait
for l in "${ALVOS[@]}"; do cat "$TMP/${l%% *}" 2>/dev/null; done | sort -V
